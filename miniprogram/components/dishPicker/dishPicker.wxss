/* components/dishPicker/dishPicker.wxss */
.picker-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-container.keyboard-open {
  padding-bottom: 0;
}

.picker-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.picker-header .picker-close {
  margin: 0;
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background: #e8f5e9;
  color: #286735;
}

.picker-search {
  flex-shrink: 0;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  background: #f5f5f5;
  border-radius: 34rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.picker-voice-btn {
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 34rpx;
  background: #e8f5e9;
  border: 1rpx solid #a5d6a7;
  color: #2e7d32;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: bold;
  user-select: none;
}

.picker-voice-btn.recording {
  background: #4CAF50;
  border-color: #4CAF50;
  color: #fff;
}

.picker-voice-icon {
  font-size: 26rpx;
}

.picker-voice-label {
  line-height: 1;
}

.picker-list {
  flex: 1;
  height: 0;
  min-height: 0;
}

.selection-bar,
.selected-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.selection-bar {
  flex-shrink: 0;
  height: 80rpx;
  background: #f5f9f5;
}

.selection-count {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: bold;
}

.selection-preview {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: #555;
}

.selection-bar .selection-toggle,
.selected-item .selection-remove {
  flex-shrink: 0;
  margin: 0 0 0 auto;
  padding: 0 12rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  background: transparent;
  color: #286735;
}

.selection-toggle[disabled] {
  opacity: 0.5;
}

.selected-item {
  min-height: 88rpx;
}

.selected-item .picker-item-name {
  min-width: 0;
  overflow-wrap: anywhere;
}

.selected-item .selection-remove {
  color: #a53024;
}

.picker-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.15s;
}

.picker-item:active {
  background: #f0f9f0;
}

.picker-item-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.picker-item-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.picker-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.picker-item-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.picker-item-count {
  font-size: 22rpx;
  color: #999;
}

/* 添加按钮 */
.picker-add-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.picker-item:active .picker-add-btn {
  background: #e8f5e9;
}

.add-icon {
  color: #4CAF50;
  font-size: 32rpx;
  font-weight: normal;
  line-height: 48rpx;
  margin-top: -2rpx;
}
