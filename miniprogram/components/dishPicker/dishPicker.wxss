/* components/dishPicker/dishPicker.wxss */
.picker-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-container.keyboard-open {
  padding-bottom: 0;
}

.picker-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.picker-header .picker-close {
  margin: 0;
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background: #e8f5e9;
  color: #286735;
}

.picker-search {
  flex-shrink: 0;
  padding: 20rpx 30rpx;
}

.picker-search-input {
  height: 68rpx;
  background: #f5f5f5;
  border-radius: 34rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.picker-list {
  flex: 1;
  height: 0;
  min-height: 0;
}

.picker-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.15s;
}

.picker-item:active {
  background: #f0f9f0;
}

.picker-item-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.picker-item-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.picker-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.picker-item-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.picker-item-count {
  font-size: 22rpx;
  color: #999;
}

/* 添加按钮 */
.picker-add-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.picker-item:active .picker-add-btn {
  background: #e8f5e9;
}

.add-icon {
  color: #4CAF50;
  font-size: 32rpx;
  font-weight: normal;
  line-height: 48rpx;
  margin-top: -2rpx;
}
