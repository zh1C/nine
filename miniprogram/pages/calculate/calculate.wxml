<!--pages/calculate/calculate.wxml-->
<page-meta page-style="{{(showPicker || showDetail || showVoiceResult) ? 'overflow: hidden;' : ''}}" />
<view class="calculate-page">
  <view wx:if="{{draftChoices.length}}" class="card">
    <view class="draft-header">
      <text class="section-title">本地未保存草稿（{{draftChoices.length}}）</text>
      <text class="draft-toggle" bindtap="toggleDraftChoices">{{showDraftChoices ? '暂不恢复' : '展开'}}</text>
    </view>
    <block wx:if="{{showDraftChoices}}">
      <view class="draft-item" wx:for="{{draftChoices}}" wx:key="key">
        <view class="draft-info">
          <text>{{item.dateLabel}}</text>
          <text class="draft-time">{{item.timeLabel}}</text>
        </view>
        <view class="dish-detail-btn" data-key="{{item.key}}" bindtap="restoreDraft">{{item.hasResult ? '恢复清单' : '继续选菜'}}</view>
        <view class="draft-discard" data-key="{{item.key}}" bindtap="discardDraft">丢弃</view>
      </view>
    </block>
  </view>
  <!-- 页面加载中 -->
  <view wx:if="{{pageLoading}}" class="page-loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载数据中...</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="page-error">
    <text class="error-icon">⚠️</text>
    <text class="error-text">数据加载失败，请重试</text>
    <view class="retry-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <!-- 主内容 -->
  <block wx:else>
  <!-- 日期选择 -->
  <view class="card">
    <view class="section-title">📅 选择下单日期</view>

    <!-- 月份切换 -->
    <view class="calendar-nav">
      <view class="nav-btn" bindtap="prevMonth">◀</view>
      <text class="nav-title">{{currentYear}}年{{currentMonth}}月</text>
      <view class="nav-btn" bindtap="nextMonth">▶</view>
    </view>

    <!-- 星期表头 -->
    <view class="calendar-week">
      <text wx:for="{{weekDays}}" wx:key="*this" class="week-cell">{{item}}</text>
    </view>

    <!-- 日期网格 -->
    <view class="calendar-grid">
      <view
        wx:for="{{calendarDays}}"
        wx:key="date"
        class="day-cell {{item.empty ? 'empty' : ''}} {{item.selected ? 'selected' : ''}}"
        bindtap="toggleDate"
        data-date="{{item.date}}"
      >
        <text wx:if="{{!item.empty}}" class="day-text">{{item.day}}</text>
      </view>
    </view>

    <!-- 快捷选择 -->
    <view class="quick-btns">
      <view class="quick-btn" bindtap="selectThisWeek">本周剩余</view>
      <view class="quick-btn" bindtap="selectNextWeek">下周一至五</view>
    </view>

    <!-- 已选日期 -->
    <view wx:if="{{selectedDates.length > 0}}" class="selected-dates">
      <text class="selected-label">已选 {{selectedDates.length}} 天</text>
    </view>
  </view>

  <!-- 每日菜品选择 -->
  <view class="card" wx:if="{{selectedDates.length > 0}}">
    <view class="section-title">🥘 选择每日菜品</view>

    <!-- 日期Tab -->
    <scroll-view class="date-tabs" scroll-x>
      <view
        wx:for="{{dateTabList}}"
        wx:key="date"
        class="date-tab {{currentDateIdx === index ? 'active' : ''}}"
        data-idx="{{index}}"
        bindtap="switchDateTab"
      >
        <text class="tab-text">{{item.label}}</text>
        <!-- 已选菜品小绿点 -->
        <view wx:if="{{item.dishCount > 0}}" class="tab-badge"></view>
        <!-- 未选菜品小黄点 -->
        <view wx:elif="{{item.dishCount === 0}}" class="tab-dot"></view>
      </view>
    </scroll-view>

    <!-- 学生/老师 子Tab -->
    <view class="sub-tabs">
      <view
        class="sub-tab {{dailySubTab === 'student' ? 'active' : ''}}"
        bindtap="switchSubTab"
        data-tab="student"
      >
        <text class="sub-tab-text">🎒 学生菜品</text>
        <view wx:if="{{studentDishCount > 0}}" class="sub-badge">{{studentDishCount}}</view>
      </view>
      <view
        class="sub-tab {{dailySubTab === 'teacher' ? 'active' : ''}}"
        bindtap="switchSubTab"
        data-tab="teacher"
      >
        <text class="sub-tab-text">👨‍🏫 老师菜品</text>
        <view wx:if="{{teacherDishCount > 0}}" class="sub-badge">{{teacherDishCount}}</view>
      </view>
    </view>

    <!-- 当天当前类型已选菜品列表 -->
    <view class="daily-dishes">
      <block wx:if="{{currentCategoryDishes.length > 0}}">
        <view
          wx:for="{{currentCategoryDishes}}"
          wx:key="_id"
          class="dish-item"
        >
          <view class="dish-item-info">
            <image
              wx:if="{{item.imageFileID}}"
              class="dish-item-image"
              src="{{item.imageFileID}}"
              mode="aspectFill"
            />
            <view wx:else class="dish-item-placeholder">🍽️</view>
            <view class="dish-item-text">
              <text class="dish-item-name">{{item.name}}</text>
              <text class="dish-item-summary">{{item.summary}}</text>
            </view>
          </view>
          <view class="dish-item-actions">
            <view class="dish-detail-btn" data-idx="{{index}}" bindtap="showDishDetail">详情</view>
            <view class="dish-item-remove" data-id="{{item._id}}" bindtap="removeDailyDish">✕</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty-daily">
        <text class="empty-text">{{dailySubTab === 'student' ? '学生' : '老师'}}当天未选择菜品</text>
      </view>
    </view>

    <!-- 添加菜品与语音报菜操作栏 -->
    <view class="add-dish-actions">
      <view class="add-dish-btn" bindtap="showDishPicker">
        <text>+ 搜索添加{{dailySubTab === 'student' ? '学生' : '老师'}}菜品</text>
      </view>
      <view
        class="voice-dish-btn {{voiceRecording ? 'recording' : ''}}"
        catchtouchstart="onVoiceTouchStart"
        catchtouchmove="onVoiceTouchMove"
        catchtouchend="onVoiceTouchEnd"
        catchtouchcancel="onVoiceTouchCancel"
      >
        <text class="voice-btn-icon">🎤</text>
        <text class="voice-btn-text">{{voiceRecording ? '松开识别' : '按住报菜'}}</text>
      </view>
    </view>
  </view>

  <!-- 计算按钮 -->
  <button class="calculate-btn" bindtap="handleCalculate" wx:if="{{selectedDates.length > 0}}">
    {{hasDraftResult ? '查看配料清单' : '开始计算'}} →
  </button>
  </block>

  <!-- 菜品选择器 -->
  <dish-picker
    show="{{showPicker}}"
    title="{{dailySubTab === 'student' ? '添加学生菜品' : '添加老师菜品'}}"
    selectedDishes="{{pickerSelectedDishes}}"
    allDishes="{{filteredDishes}}"
    voiceRecording="{{voiceRecording}}"
    bind:add="onPickerAdd"
    bind:remove="removeDailyDish"
    bind:close="onPickerClose"
    bind:voicestart="onVoiceTouchStart"
    bind:voicemove="onVoiceTouchMove"
    bind:voiceend="onVoiceTouchEnd"
    bind:voicecancel="onVoiceTouchCancel"
  />

  <!-- 录音中全屏提示浮层 -->
  <view class="voice-recording-toast {{voiceCancelMove ? 'cancel-mode' : ''}}" wx:if="{{voiceRecording}}">
    <view class="voice-wave">
      <view class="wave-bar b1"></view>
      <view class="wave-bar b2"></view>
      <view class="wave-bar b3"></view>
      <view class="wave-bar b4"></view>
      <view class="wave-bar b5"></view>
    </view>
    <text class="voice-toast-title">{{voiceCancelMove ? '松开手指，取消识别' : '正在聆听… 松开手指识别'}}</text>
    <text class="voice-toast-tip">{{voiceCancelMove ? '已进入取消区域' : '请连贯报出菜名，如：红烧排骨、番茄炒蛋、紫菜汤'}}</text>
    <text class="voice-toast-sub">{{voiceCancelMove ? '' : '手指上滑可取消'}}</text>
  </view>

  <!-- 语音识别结果确认弹窗（每次识别均弹出，由用户手动确认添加） -->
  <view class="detail-mask voice-result-mask" wx:if="{{showVoiceResult}}" bindtap="closeVoiceResult">
    <view class="detail-panel voice-result-panel" catchtap="preventBubble">
      <view class="detail-handle"></view>

      <!-- 头部 -->
      <view class="detail-hd">
        <text class="voice-hd-icon">🎤</text>
        <text class="detail-name">语音识别结果确认</text>
        <view class="detail-tag">{{voiceTargetLabel}}</view>
      </view>

      <!-- 识别原文编辑与重匹配栏 -->
      <view class="voice-raw-bar">
        <input
          class="voice-raw-input"
          value="{{voiceRawText}}"
          placeholder="识别文本（可手动改字后点重新匹配）"
          bindinput="onVoiceRawTextInput"
          confirm-type="done"
          bindconfirm="handleVoiceRematch"
        />
        <view class="voice-rematch-btn" bindtap="handleVoiceRematch">
          {{voiceRematching ? '匹配中' : '重新匹配'}}
        </view>
      </view>

      <!-- 词条匹配列表 -->
      <scroll-view class="detail-body voice-result-body" scroll-y>
        <view wx:for="{{voiceItems}}" wx:key="id" wx:for-index="vIdx" class="voice-seg-card">
          <view class="voice-seg-hd">
            <text class="voice-spoken">「{{item.spokenText}}」</text>
            <text class="voice-status-tag tag-{{item.status}}">{{item.matchTag}}</text>
          </view>

          <!-- 唯一高置信命中 -->
          <block wx:if="{{item.status === 'matched'}}">
            <view
              wx:for="{{item.candidates}}"
              wx:for-item="cand"
              wx:key="_id"
              class="voice-cand-row {{cand.checked ? 'checked' : ''}}"
              data-item-idx="{{vIdx}}"
              data-dish-id="{{cand._id}}"
              bindtap="toggleVoiceDish"
            >
              <view class="voice-checkbox {{cand.checked ? 'checked' : ''}}">{{cand.checked ? '✓' : ''}}</view>
              <view class="voice-cand-info">
                <text class="voice-cand-name">{{cand.name}}</text>
                <text class="voice-cand-summary">{{cand.summary}}</text>
              </view>
            </view>
          </block>

          <!-- 原名称命中 + 归一化包含备选（原名置顶默认勾选，全部采用独立复选框） -->
          <block wx:elif="{{item.status === 'matched_variants'}}">
            <view class="voice-cand-list">
              <block wx:for="{{item.candidates}}" wx:for-item="cand" wx:for-index="cIdx" wx:key="_id">
                <text wx:if="{{cIdx === 1}}" class="voice-variant-divider">关联备选菜品（独立勾选，互不排斥）：</text>
                <view
                  class="voice-cand-row {{cand.checked ? 'checked' : ''}}"
                  data-item-idx="{{vIdx}}"
                  data-dish-id="{{cand._id}}"
                  bindtap="toggleVoiceDish"
                >
                  <view class="voice-checkbox {{cand.checked ? 'checked' : ''}}">{{cand.checked ? '✓' : ''}}</view>
                  <view class="voice-cand-info">
                    <view class="voice-cand-title-row">
                      <text class="voice-cand-name">{{cand.name}}</text>
                      <text wx:if="{{cand.isPrimary}}" class="voice-primary-badge">原名</text>
                    </view>
                    <text class="voice-cand-summary">{{cand.summary}}</text>
                  </view>
                </view>
              </block>
            </view>
          </block>

          <!-- 包含或模糊多候选：独立复选框由用户手动勾选 -->
          <block wx:elif="{{item.status === 'multiple'}}">
            <text class="voice-multi-hint">请勾选需要添加的菜品（可多选）：</text>
            <view class="voice-cand-list">
              <view
                wx:for="{{item.candidates}}"
                wx:for-item="cand"
                wx:key="_id"
                class="voice-cand-row {{cand.checked ? 'checked' : ''}}"
                data-item-idx="{{vIdx}}"
                data-dish-id="{{cand._id}}"
                bindtap="toggleVoiceDish"
              >
                <view class="voice-checkbox {{cand.checked ? 'checked' : ''}}">{{cand.checked ? '✓' : ''}}</view>
                <view class="voice-cand-info">
                  <text class="voice-cand-name">{{cand.name}}</text>
                  <text class="voice-cand-summary">{{cand.summary}}</text>
                </view>
              </view>
            </view>
          </block>

          <!-- 已在当天菜单中 -->
          <view wx:elif="{{item.status === 'already_selected'}}" class="voice-already-row">
            <text class="voice-already-text">已选菜品「{{item.matchedDishName}}」，无需重复添加</text>
          </view>

          <!-- 当前餐别未找到 -->
          <view wx:else class="voice-unmatched-row">
            <text class="voice-unmatched-text">当前{{dailySubTab === 'student' ? '学生' : '老师'}}菜品库中暂无此菜</text>
            <view class="voice-add-new-btn" data-name="{{item.spokenText}}" bindtap="goAddUnmatchedDish">
              + 去新增菜品
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 底部操作栏 -->
      <view class="voice-footer">
        <view class="voice-cancel-btn" bindtap="closeVoiceResult">取消</view>
        <view
          class="voice-rerecord-btn {{voiceRecording ? 'recording' : ''}}"
          catchtouchstart="onVoiceTouchStart"
          catchtouchmove="onVoiceTouchMove"
          catchtouchend="onVoiceTouchEnd"
          catchtouchcancel="onVoiceTouchCancel"
        >
          🎤 按住重录
        </view>
        <view
          class="voice-confirm-btn {{voiceSelectedCount > 0 ? '' : 'disabled'}}"
          bindtap="confirmVoiceAdd"
        >
          确认添加（{{voiceSelectedCount}}道）
        </view>
      </view>
    </view>
  </view>

  <!-- 配料详情弹窗 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-panel" catchtap="preventBubble">
      <view class="detail-handle"></view>

      <!-- 头部 -->
      <view class="detail-hd">
        <image wx:if="{{detailDish.imageFileID}}" class="detail-img" src="{{detailDish.imageFileID}}" mode="aspectFill" />
        <view wx:else class="detail-img-ph">🍽️</view>
        <text class="detail-name">{{detailDish.name}}</text>
        <view class="detail-tag">{{detailDish.categoryLabel}}</view>
      </view>

      <scroll-view class="detail-body" scroll-y>
        <!-- 配料属性（默认折叠） -->
        <view class="detail-ing-bar" bindtap="toggleDetailIng">
          <text class="detail-ing-title">配料属性（{{detailIngredients.length}}种）</text>
          <text class="detail-ing-arrow">{{detailIngExpanded ? '▲' : '▼'}}</text>
        </view>
        <view class="detail-ing-table" wx:if="{{detailIngExpanded}}">
          <view class="dit-hd">
            <text class="dit-name">配料名</text>
            <text class="dit-unit">单位</text>
            <text class="dit-type">类型</text>
            <text class="dit-adv">提前</text>
            <text class="dit-reuse">重复</text>
          </view>
          <view wx:for="{{detailIngredients}}" wx:key="index" class="dit-row">
            <text class="dit-name">{{item.name}}</text>
            <text class="dit-unit">{{item.unit}}</text>
            <text class="dit-type">{{item.type}}</text>
            <text class="dit-adv">{{item.advance ? '🚚' : '-'}}</text>
            <text class="dit-reuse">{{item.reuse ? '🔄' : '-'}}</text>
          </view>
        </view>

        <!-- 各园区用量（默认全部展开） -->
        <view wx:for="{{detailGardens}}" wx:key="gardenId" class="detail-gd">
          <view class="detail-gd-hd">
            <text class="detail-gd-name">{{item.name}}</text>
            <view class="detail-gd-st {{item.filled ? 'gd-ok' : 'gd-warn'}}">
              <text>{{item.filled ? '已配' : '未配'}}</text>
            </view>
          </view>
          <!-- 已配园区：两列紧凑展示 -->
          <view class="detail-gd-grid" wx:if="{{item.filled}}">
            <view wx:for="{{detailIngredients}}" wx:for-item="ing" wx:for-index="ii" wx:key="ii" class="detail-gd-cell">
              <text class="gd-cell-name">{{ing.name}}</text>
              <text class="gd-cell-val">{{item.ratios[ii] || '-'}} {{ing.unit}}</text>
              <text class="gd-cell-adv" wx:if="{{ing.advance}}">🚚</text>
              <text class="gd-cell-reuse" wx:if="{{ing.reuse}}">🔄</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="detail-close" bindtap="closeDetail">关闭</view>
    </view>
  </view>
</view>
