/* pages/gardenMetaManage/gardenMetaManage.wxss */
.meta-manage-page {
  min-height: 100vh;
  padding: 30rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-btn {
  height: 72rpx;
  padding: 0 30rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-btn {
  height: 72rpx;
  padding: 0 24rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 列表 */
.garden-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.garden-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.garden-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.badge-configured {
  background: #e8f5e9;
  color: #2e7d32;
}

.badge-empty {
  background: #f0f0f0;
  color: #888;
}

/* 元信息内容 */
.meta-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fafafa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.meta-label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #777;
}

.meta-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.password-mask {
  letter-spacing: 4rpx;
  color: #666;
}

.mini-btn {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  background: #eef3f8;
  color: #1976d2;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.mini-btn:active {
  opacity: 0.7;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.update-time {
  font-size: 24rpx;
  color: #999;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-left: auto;
}

.edit-btn {
  padding: 10rpx 28rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.edit-btn:active {
  opacity: 0.7;
}

.delete-btn {
  padding: 10rpx 28rpx;
  background: #ffebee;
  color: #d32f2f;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.delete-btn:active {
  opacity: 0.7;
}

/* 未配置行 */
.unconfigured-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

.unconfigured-tip {
  font-size: 26rpx;
  color: #999;
}

.add-meta-btn {
  padding: 12rpx 32rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.add-meta-btn:active {
  opacity: 0.8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-subtext {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.dialog-box {
  width: 82%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  text-align: center;
  color: #333;
}

.dialog-subtitle {
  font-size: 26rpx;
  color: #4CAF50;
  display: block;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.dialog-input {
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.password-input-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.password-input {
  flex: 1;
}

.toggle-pwd-btn {
  flex-shrink: 0;
  padding: 16rpx 22rpx;
  background: #f0f0f0;
  color: #555;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.toggle-pwd-btn:active {
  opacity: 0.7;
}

.dialog-btns {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
}

.dialog-cancel,
.dialog-confirm {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.dialog-cancel {
  background: #f5f5f5;
  color: #666;
}

.dialog-confirm {
  background: #4CAF50;
  color: #fff;
}

.dialog-cancel:active,
.dialog-confirm:active {
  opacity: 0.8;
}
