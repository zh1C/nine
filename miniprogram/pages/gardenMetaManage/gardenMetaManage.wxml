<!--pages/gardenMetaManage/gardenMetaManage.wxml-->
<view class="meta-manage-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索园区名称..." value="{{keyword}}" bindinput="onInputSearch" bindconfirm="handleSearch" />
    <view class="search-btn" bindtap="handleSearch">
      <text>搜索</text>
    </view>
    <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">
      <text>清除</text>
    </view>
  </view>

  <!-- 园区元信息列表 -->
  <view class="garden-list">
    <view class="garden-card" wx:for="{{gardens}}" wx:key="gardenId">
      <view class="card-header">
        <view class="garden-name">{{item.name}}</view>
        <view class="status-badge {{item.hasMeta ? 'badge-configured' : 'badge-empty'}}">
          {{item.hasMeta ? '已配置' : '未配置'}}
        </view>
      </view>

      <!-- 已配置状态 -->
      <view class="meta-body" wx:if="{{item.hasMeta}}">
        <view class="meta-row">
          <text class="meta-label">用户名</text>
          <text class="meta-value">{{item.accountUsername}}</text>
          <view class="mini-btn" bindtap="copyAccount" data-account="{{item.accountUsername}}">
            <text>复制</text>
          </view>
        </view>
        <view class="meta-row">
          <text class="meta-label">密码</text>
          <text class="meta-value {{revealedPasswords[item.gardenId] ? '' : 'password-mask'}}">{{revealedPasswords[item.gardenId] || '••••••••'}}</text>
          <view class="mini-btn" bindtap="togglePassword" data-garden-id="{{item.gardenId}}">
            <text>{{revealedPasswords[item.gardenId] ? '隐藏' : '查看'}}</text>
          </view>
          <view class="mini-btn" bindtap="copyPassword" data-garden-id="{{item.gardenId}}">
            <text>复制</text>
          </view>
        </view>
        <view class="card-footer">
          <text class="update-time" wx:if="{{item.updateTimeStr}}">更新: {{item.updateTimeStr}}</text>
          <view class="card-actions">
            <view class="edit-btn" bindtap="openMetaDialog" data-garden="{{item}}">
              <text>编辑</text>
            </view>
            <view class="delete-btn" bindtap="clearMeta" data-garden-id="{{item.gardenId}}" data-name="{{item.name}}">
              <text>清空</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 未配置状态 -->
      <view class="unconfigured-row" wx:else>
        <text class="unconfigured-tip">暂未录入账号密码</text>
        <view class="add-meta-btn" bindtap="openMetaDialog" data-garden="{{item}}">
          <text>录入</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && gardens.length === 0}}">
    <text class="empty-icon">🔐</text>
    <text class="empty-text">{{keyword ? '未找到匹配的园区' : '暂无园区数据'}}</text>
    <text class="empty-subtext" wx:if="{{!keyword}}">请先前往「园区管理」添加园区</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 录入/编辑弹窗 -->
  <view class="dialog-mask" wx:if="{{showDialog}}" bindtap="hideDialog">
    <view class="dialog-box" catchtap="noop">
      <text class="dialog-title">{{dialogIsEdit ? '编辑元信息' : '录入元信息'}}</text>
      <text class="dialog-subtitle">{{dialogGardenName}}</text>

      <view class="form-item">
        <text class="form-label">用户名</text>
        <input
          class="dialog-input"
          placeholder="请输入园区用户名"
          value="{{dialogAccountUsername}}"
          bindinput="onDialogAccountInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">密码</text>
        <view class="password-input-wrap">
          <input
            class="dialog-input password-input"
            type="text"
            password="{{!showDialogPassword}}"
            placeholder="请输入园区密码"
            value="{{dialogPassword}}"
            bindinput="onDialogPasswordInput"
          />
          <view class="toggle-pwd-btn" bindtap="toggleDialogPassword">
            <text>{{showDialogPassword ? '隐藏' : '显示'}}</text>
          </view>
        </view>
      </view>

      <view class="dialog-btns">
        <view class="dialog-cancel" bindtap="hideDialog">取消</view>
        <view class="dialog-confirm" bindtap="confirmDialog">保存</view>
      </view>
    </view>
  </view>
</view>
