/* pages/cartResult/cartResult.wxss */
.result-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部进度 */
.progress-card {
  background: #fff;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #eee;
}

.progress-text {
  font-size: 26rpx;
  color: #2e7d32;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 10rpx;
  background: #e8f5e9;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #4caf50;
  transition: width 0.2s ease;
}

/* 园区 Tab */
.garden-tabs {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #eee;
}

.tabs-inner {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: #f3f4f3;
  color: #555;
  font-size: 26rpx;
}

.tab-item.active {
  background: #4caf50;
  color: #fff;
  font-weight: 600;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 20rpx;
  padding: 0 8rpx;
}

.tab-badge.ok {
  background: #e8f5e9;
  color: #2e7d32;
}

.tab-badge.warn {
  background: #fff3e0;
  color: #e65100;
}

.tab-badge.err {
  background: #ffebee;
  color: #c62828;
}

.tab-badge.ing {
  background: #e3f2fd;
  color: #1565c0;
}

/* 园区内容区 */
.garden-panel {
  padding: 24rpx 28rpx;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.summary-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.summary-sub {
  font-size: 24rpx;
  color: #888;
}

.summary-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-box {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.stat-num.ok {
  color: #4caf50;
}

.stat-num.warn {
  color: #f57c00;
}

.stat-label {
  font-size: 22rpx;
  color: #888;
}

/* 阻断卡片 */
.block-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 56rpx 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.block-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.block-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.block-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.block-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.cart-btn-primary,
.cart-btn-outline {
  margin: 0;
  width: auto !important;
  height: 76rpx;
  padding: 0 36rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cart-btn-primary {
  background: #4caf50;
  color: #fff;
}

.cart-btn-outline {
  background: #fff;
  color: #4caf50;
  border: 2rpx solid #4caf50;
}

/* 分区 */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.toggle-text {
  font-size: 24rpx;
  color: #4caf50;
}

/* 异常项卡片 */
.fail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.fail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.fail-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.fail-origin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fail-tag {
  font-size: 22rpx;
  line-height: 1.2;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #fff3e0;
  color: #e65100;
  font-weight: 500;
  flex-shrink: 0;
}

.fail-weight {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.fail-reason {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #f6f7f6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.retry-one-btn {
  margin: 0;
  width: auto !important;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #4caf50;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.candidate-wrap {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #eee;
}

.candidate-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.candidate-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.candidate-chip {
  padding: 8rpx 18rpx;
  background: #f1f8f2;
  color: #2e7d32;
  border-radius: 10rpx;
  font-size: 24rpx;
}

/* 成功列表 */
.success-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.success-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
  font-size: 28rpx;
}

.success-item:last-child {
  border-bottom: none;
}

.success-name {
  color: #333;
}

.success-qty {
  color: #4caf50;
  font-weight: 600;
}

/* 底部批量继续 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 20;
}

.continue-btn {
  margin: 0;
  width: 100% !important;
  height: 82rpx;
  padding: 0;
  border-radius: 41rpx;
  background: #4caf50;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
