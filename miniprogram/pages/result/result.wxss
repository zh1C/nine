/* pages/result/result.wxss */
.result-page {
  min-height: 100vh;
  padding: 20rpx 30rpx 40rpx;
  background: #f5f5f5;
}

/* ====== 顶部提示条 ====== */
.page-tip-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  background: #e3f2fd;
  border-radius: 12rpx;
}

.page-tip-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.page-tip-text {
  font-size: 24rpx;
  color: #1565C0;
}

/* 表格卡片 */
.table-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.table-card-header {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-header {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}

.table-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.table-card-count {
  display: flex;
  align-items: baseline;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.count-icon {
  font-size: 22rpx;
}

.count-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin: 0 4rpx;
}

.count-unit {
  font-size: 22rpx;
  color: #fff;
  opacity: 0.9;
}

/* 表格 */
.table-wrapper {
  padding: 0;
}

.table-scroll {
  width: 100%;
}

.table-inner {
  min-width: 100%;
  display: inline-block;
}

.table-header-row {
  display: flex;
  background: #f5f5f5;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.table-data-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-data-row.even {
  background: #fafafa;
}

.table-data-row:last-child {
  border-bottom: none;
}

.table-data-row:active {
  background: #f0f7ff;
}

.th {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
  text-align: center;
  padding: 0 8rpx;
}

.th-name {
  min-width: 160rpx;
  text-align: left;
  padding-left: 24rpx;
}

.th-garden {
  min-width: 140rpx;
}

.th-unit {
  min-width: 80rpx;
}

.th-date {
  min-width: 160rpx;
  text-align: left;
  padding-left: 24rpx;
}

.th-garden-wide {
  min-width: 180rpx;
}

.td {
  font-size: 26rpx;
  text-align: center;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.td-name {
  min-width: 160rpx;
  text-align: left;
  padding-left: 24rpx;
  color: #333;
  justify-content: flex-start;
}

.td-amount {
  min-width: 140rpx;
  color: #ccc;
  flex-direction: column;
  position: relative;
}

.td-amount.has-value {
  color: #FF9800;
  font-weight: bold;
}

.td-amount.adjusted {
  background: #fff8e1;
  border-radius: 8rpx;
}

.amount-val {
  font-size: 26rpx;
  line-height: 1.2;
}

.adjust-badge {
  font-size: 18rpx;
  line-height: 1;
  font-weight: bold;
  margin-top: 2rpx;
}

.badge-up {
  color: #4CAF50;
}

.badge-down {
  color: #F44336;
}

.td-unit {
  min-width: 80rpx;
  color: #666;
}

.td-date {
  min-width: 160rpx;
  text-align: left;
  padding-left: 24rpx;
  color: #333;
  font-weight: bold;
  justify-content: flex-start;
}

.td-dishes {
  min-width: 180rpx;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 8rpx;
}

/* 菜品分组展示 */
.dish-group {
  margin-bottom: 8rpx;
  width: 100%;
}

.dish-group:last-child {
  margin-bottom: 0;
}

.dish-group-label {
  display: block;
  font-size: 20rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
  color: #666;
}

.student-group .dish-group-label {
  color: #1976D2;
}

.teacher-group .dish-group-label {
  color: #E65100;
}

.dish-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  justify-content: center;
}

.dish-tag {
  font-size: 22rpx;
  color: #333;
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin: 2rpx 0;
  display: inline-block;
}

.student-tag {
  background: #E3F2FD;
  color: #1565C0;
}

.teacher-tag {
  background: #FFF3E0;
  color: #E65100;
}

.no-dish {
  font-size: 24rpx;
  color: #ccc;
}

/* 保存按钮 */
.table-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  color: #2196F3;
  font-size: 26rpx;
}

.table-save-btn:active {
  background: #f5f5f5;
}

/* 底部操作 */
.bottom-actions {
  margin-top: 20rpx;
  padding-bottom: 40rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.save-record-btn {
  background-color: #FF9800 !important;
  color: #fff !important;
}

.save-record-btn.saved {
  background-color: #a5d6a7 !important;
  color: #fff !important;
}

/* ====== 配料调整弹窗（居中模式） ====== */
.adjust-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.adjust-modal {
  width: 620rpx;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.adjust-modal-header {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 28rpx;
}

.adjust-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.adjust-modal-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 园区列表滚动区 */
.adjust-garden-scroll {
  max-height: 50vh;
  margin-bottom: 28rpx;
}

.adjust-garden-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.adjust-garden-row:last-child {
  border-bottom: none;
}

.adjust-garden-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.adjust-garden-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

/* 加减按钮 */
.adj-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.adj-btn.minus {
  background: #ffebee;
  color: #F44336;
}

.adj-btn.plus {
  background: #e8f5e9;
  color: #4CAF50;
}

.adj-btn:active {
  opacity: 0.6;
  transform: scale(0.9);
}

.editor-fields, .row-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.name-input, .amount-input, .unit-value {
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  font-size: 28rpx;
}
.name-input { flex: 1; min-width: 0; }
.amount-input { width: 130rpx; text-align: center; }
.row-actions { padding: 0 8rpx 24rpx; font-size: 26rpx; color: #555; }
.delete-row { color: #b42318; }
.add-row { color: #287d36; }
.base-amount { display: block; margin-bottom: 8rpx; color: #666; font-size: 24rpx; }
.empty-day { text-align: center; padding: 24rpx; color: #666; font-size: 26rpx; }

/* 底部操作按钮 */
.adjust-modal-actions {
  display: flex;
  gap: 20rpx;
}

.adjust-act-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.act-reset {
  background: #f5f5f5;
  color: #666;
}

.act-reset:active {
  background: #e0e0e0;
}

.act-confirm {
  background: #FF9800;
  color: #fff;
}

.act-confirm:active {
  background: #F57C00;
}
